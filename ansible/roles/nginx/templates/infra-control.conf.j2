# Managed by infra_control (role nginx). Site server blocks come from `bench setup nginx`.
client_max_body_size {{ nginx_client_max_body_size }};
server_tokens {{ nginx_server_tokens }};

# The bench's generated server blocks log with the `main` format, which `bench setup production`
# would add; it is defined here because the bench role wires nginx itself (live gate, JOB-00009).
log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                '$status $body_bytes_sent "$http_referer" '
                '"$http_user_agent" "$http_x_forwarded_for"';
